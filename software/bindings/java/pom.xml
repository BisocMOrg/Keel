<!--
  The Java binding of libkeel: io.github.bisocmorg:keel, JPMS module io.github.bisocmorg.keel.
  A pure-Java jar over the Foreign Function and Memory API; it loads the system's libkeel.so.1.
  The version equals keel.h (KEEL_VERSION_*); software/bindings/tools/keelgen.py checks it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.bisocmorg</groupId>
  <artifactId>keel</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Keel Java binding</name>
  <description>Java binding of libkeel, the host library of the Keel robot baseboard</description>
  <url>https://github.com/BisocMOrg/Keel/tree/main/software/bindings/java</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>BisocM</name>
    <url>https://github.com/BisocMOrg</url>
  </organization>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>BisocM</id>
      <name>BisocM</name>
      <url>https://github.com/BisocMOrg</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/BisocMOrg/Keel.git</connection>
    <developerConnection>scm:git:git@github.com:BisocMOrg/Keel.git</developerConnection>
    <url>https://github.com/BisocMOrg/Keel/tree/main/software/bindings/java</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/BisocMOrg/Keel/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- The release date: jar entries carry it, so a rebuild of a release is byte-identical. -->
    <project.build.outputTimestamp>2026-11-07T00:00:00Z</project.build.outputTimestamp>
    <!-- libkeel's source tree: tests/abi/layout.c, symbols.txt and keel.h for the ABI tests. -->
    <keel.source.dir>${project.basedir}/../../libkeel</keel.source.dir>
    <keel.repository.dir>${project.basedir}/../../..</keel.repository.dir>
    <!-- Tests run on the class path; native access is granted to it and denied everywhere else. -->
    <keel.test.jvm>--enable-native-access=ALL-UNNAMED --illegal-native-access=deny</keel.test.jvm>
    <keel.test.excludedGroups>hardware</keel.test.excludedGroups>
    <!-- Set by jacoco:prepare-agent; empty when JaCoCo is skipped. -->
    <argLine/>

    <version.junit>6.1.3</version.junit>
    <version.plugin.clean>3.5.0</version.plugin.clean>
    <version.plugin.compiler>3.16.0</version.plugin.compiler>
    <version.plugin.deploy>3.1.4</version.plugin.deploy>
    <version.plugin.enforcer>3.6.3</version.plugin.enforcer>
    <version.plugin.failsafe>3.5.6</version.plugin.failsafe>
    <version.plugin.install>3.1.4</version.plugin.install>
    <version.plugin.jacoco>0.8.16</version.plugin.jacoco>
    <version.plugin.jar>3.5.1</version.plugin.jar>
    <version.plugin.javadoc>3.12.0</version.plugin.javadoc>
    <version.plugin.resources>3.5.0</version.plugin.resources>
    <version.plugin.site>3.21.0</version.plugin.site>
    <version.plugin.source>3.4.0</version.plugin.source>
    <version.plugin.surefire>3.5.6</version.plugin.surefire>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- No runtime dependencies: the binding needs only java.base and the system's libkeel.so.1. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- The repository's licence text, shipped in the jar as META-INF/LICENSE. -->
      <resource>
        <directory>${keel.repository.dir}</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${version.plugin.clean}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${version.plugin.resources}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.plugin.compiler}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.plugin.surefire}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${version.plugin.failsafe}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${version.plugin.jar}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${version.plugin.source}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${version.plugin.javadoc}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${version.plugin.install}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${version.plugin.deploy}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${version.plugin.site}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${version.plugin.enforcer}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${version.plugin.jacoco}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requirePluginVersions>
                  <message>Every plugin is pinned to a version, so builds are reproducible.</message>
                </requirePluginVersions>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <showWarnings>true</showWarnings>
          <failOnWarning>true</failOnWarning>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs combine.self="override">
                <arg>-Xlint:all</arg>
                <arg>-Xdoclint:all/protected</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <!-- The tests are compiled into the named module (they test package-private members): they read
                   the JDK modules they use beyond the binding's, and the module-API lint "exports" would flag
                   the JUnit types of the suite's public extension. -->
              <compilerArgs combine.self="override">
                <arg>-Xlint:all,-exports</arg>
                <arg>-Werror</arg>
                <arg>--add-modules=java.compiler,java.logging</arg>
                <arg>--add-reads=io.github.bisocmorg.keel=java.compiler,java.logging</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Surefire's default would patch the tests into the named module; the tests and the
               native-access grant belong on the class path (ModulePathIT covers the module path). -->
          <useModulePath>false</useModulePath>
          <argLine>@{argLine} ${keel.test.jvm}</argLine>
          <excludedGroups>${keel.test.excludedGroups}</excludedGroups>
          <trimStackTrace>false</trimStackTrace>
          <!-- The binding logs refused and failed cycles; tests provoke many. Their output goes to
               target/surefire-reports/*-output.txt instead of the build log. -->
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <keel.source.dir>${keel.source.dir}</keel.source.dir>
            <keel.repository.dir>${keel.repository.dir}</keel.repository.dir>
            <keel.examples.dir>${project.basedir}/examples</keel.examples.dir>
            <keel.classes.dir>${project.build.outputDirectory}</keel.classes.dir>
            <keel.readme>${project.basedir}/README.md</keel.readme>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>${keel.test.jvm}</argLine>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <keel.jar>${project.build.directory}/${project.build.finalName}.jar</keel.jar>
            <keel.examples.dir>${project.basedir}/examples</keel.examples.dir>
            <keel.repository.dir>${keel.repository.dir}</keel.repository.dir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- No Enable-Native-Access: a library jar's attribute is ignored on the class path, so
                 applications grant native access themselves (README, "Native access"). -->
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <doclint>all</doclint>
          <failOnWarnings>true</failOnWarnings>
          <failOnError>true</failOnError>
          <quiet>true</quiet>
          <notimestamp>true</notimestamp>
          <detectJavaApiLink>false</detectJavaApiLink>
          <detectOfflineLinks>false</detectOfflineLinks>
          <doctitle>Keel Java binding ${project.version}</doctitle>
          <windowtitle>Keel Java binding ${project.version}</windowtitle>
          <bottom>Copyright (c) 2026 BisocM. MIT License.</bottom>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The robot stage: only the hardware tests, against the installed library.
         They run with the motion guard and without coverage: mvn -B -Phardware test -->
    <profile>
      <id>hardware</id>
      <properties>
        <groups>hardware</groups>
        <keel.test.excludedGroups/>
        <jacoco.skip>true</jacoco.skip>
        <skipITs>true</skipITs>
      </properties>
    </profile>
  </profiles>
</project>
