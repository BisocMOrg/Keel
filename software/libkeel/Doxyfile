#
# API reference for the public headers keel.h, port.h and camera.h. From
# software/libkeel:
#   mkdir -p build && doxygen Doxyfile        (HTML in build/docs/html)
# Warnings are errors: an undocumented declaration, parameter or return value
# fails the run (CI job "docs"). tests/docs/check_header_docs.py enforces the
# same rules where Doxygen is not installed. PROJECT_NUMBER follows
# KEEL_VERSION_* in keel.h (tests/packaging/check_package_metadata.py keeps
# them equal).

PROJECT_NAME           = libkeel
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Keel robot baseboard library"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/keel/keel.h include/keel/port.h include/keel/camera.h
STRIP_FROM_PATH        = include
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = NO
EXTRACT_ALL            = NO

# Doxygen is not GCC, so the header defines KEEL_API as empty for it and the
# exported declarations read as plain C.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
HAVE_DOT               = NO
