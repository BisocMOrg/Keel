#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 BisocM
#
# keel-common: make the device nodes usable now, without a reboot.
# It never edits the boot configuration, never changes the I2C bus speed and
# never adds users to groups (keel-setup does those on request).
set -e

# debhelper inserts the systemd-sysusers call for /usr/lib/sysusers.d/keel.conf
# here, so the keel group exists before udev applies 99-keel.rules below.
#DEBHELPER#

if [ "$1" = "configure" ] && [ -z "${DPKG_ROOT:-}" ]; then
    # modules-load.d covers later boots; load i2c-dev now so /dev/i2c-1 exists.
    modprobe i2c-dev 2>/dev/null || true
    # Re-evaluate the existing GPIO chip and I2C nodes under 99-keel.rules.
    # In containers and chroots udev is not running; the next boot applies it.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --action=change --subsystem-match=gpio --subsystem-match=i2c-dev \
            2>/dev/null || true
    fi
fi

exit 0
