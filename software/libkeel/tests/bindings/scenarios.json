{
  "license": "SPDX-License-Identifier: MIT",
  "copyright": "Copyright (c) 2026 BisocM",
  "format": 1,
  "description": "Language-neutral conformance scenarios (SPEC 21). Each scenario opens the virtual-clock simulator and runs its steps in order. A step is a 'call' (a C function name, 'args' after the device handle and without output pointers, 'thread' owner or other), 'cycles' (that many keel_cycle calls with health ALL and an optional command, each followed by keel_sleep_until of the next 10 ms deadline; the step's status is the first non-OK status), 'sim' (keel_sim_set) or 'expect' (checks the previous step: its status, and optionally its 'output', the 'state', the 'fault' record and 'snapshot' fields). Arguments are integers, enumerator names, a list (the colour array of keel_set_rgb_frame, whose count is its length), {\"cycle_id\": \"next\"} or {\"now_plus_us\": N}. The arguments of keel_cycle are the fields of keel_cycle_input after struct_size. A list of enumerator names as an expected value means that every named bit is set; the flags of 'fault' are exact. mcu_stage and mcu_faults are never asserted.",
  "scenarios": [
    {
      "name": "metadata",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_abi_version", "args": []},
        {"expect": "KEEL_OK", "output": "KEEL_ABI_VERSION"},
        {"call": "keel_version_string", "args": []},
        {"expect": "KEEL_OK"},
        {"call": "keel_status_name", "args": ["KEEL_E_CONFLICT"]},
        {"expect": "KEEL_OK", "output": "KEEL_E_CONFLICT"},
        {"call": "keel_status_name", "args": [-99]},
        {"expect": "KEEL_OK", "output": "KEEL_E_UNKNOWN"},
        {"call": "keel_status_string", "args": ["KEEL_E_STATE"]},
        {"expect": "KEEL_OK"},
        {"call": "keel_status_class", "args": ["KEEL_E_HEALTH"]},
        {"expect": "KEEL_OK", "output": "KEEL_CLASS_FAULT"},
        {"call": "keel_status_class", "args": ["KEEL_E_CONFLICT"]},
        {"expect": "KEEL_OK", "output": "KEEL_CLASS_REJECTED"},
        {"call": "keel_status_class", "args": [-99]},
        {"expect": "KEEL_OK", "output": "KEEL_CLASS_FAULT"},
        {"call": "keel_fault_cause_name", "args": ["KEEL_CAUSE_TICK_LATE"]},
        {"expect": "KEEL_OK", "output": "TICK_LATE"},
        {"call": "keel_fault_cause_name", "args": [9999]},
        {"expect": "KEEL_OK", "output": "UNKNOWN"}
      ]
    },
    {
      "name": "arm_drive_brake_disarm_close",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_get_capabilities", "args": []},
        {"expect": "KEEL_OK", "output": ["KEEL_CAP_MOTORS", "KEEL_CAP_BRAKE", "KEEL_CAP_SIMULATED"]},
        {"call": "keel_get_state", "args": []},
        {"expect": "KEEL_OK", "output": "KEEL_STATE_DISARMED"},
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMING"},
        {"cycles": 100},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_read_safety_inputs", "args": []},
        {"expect": "KEEL_OK", "output": ["KEEL_INPUT_READY", "KEEL_INPUT_ARMED"]},
        {"call": "keel_set_motors", "args": [400, -400]},
        {"expect": "KEEL_OK"},
        {"cycles": 3, "command": "KEEL_CYCLE_DRIVE", "left": 400, "right": -400},
        {"expect": "KEEL_OK", "snapshot": {"output_left": 400, "output_right": -400, "command_left": 400}},
        {"call": "keel_sim_get_state", "args": []},
        {"expect": "KEEL_OK", "output": {"bridge_left": 400, "bridge_right": -400, "flags": ["KEEL_SIM_MOTOR_PERMIT"]}},
        {"call": "keel_brake", "args": []},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_snapshot", "args": []},
        {"expect": "KEEL_OK", "output": {"state": "KEEL_STATE_ARMED", "flags": ["KEEL_SNAP_BRAKING", "KEEL_SNAP_SIMULATED"]}},
        {"call": "keel_disarm", "args": []},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED"},
        {"call": "keel_close", "args": []},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_state", "args": []},
        {"expect": "KEEL_E_INVALID_HANDLE"},
        {"call": "keel_disarm", "args": [], "thread": "other"},
        {"expect": "KEEL_E_INVALID_HANDLE"}
      ]
    },
    {
      "name": "thread_rule",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_OK"},
        {"cycles": 100},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_set_motors", "args": [100, 100], "thread": "other"},
        {"expect": "KEEL_E_CONFLICT"},
        {"call": "keel_brake", "args": [], "thread": "other"},
        {"expect": "KEEL_E_CONFLICT"},
        {"call": "keel_request_arm", "args": [], "thread": "other"},
        {"expect": "KEEL_E_CONFLICT"},
        {"call": "keel_set_motors", "args": [0, 0], "thread": "other"},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_range_measure", "args": []},
        {"expect": "KEEL_E_CONFLICT"},
        {"call": "keel_disarm", "args": [], "thread": "other"},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED"},
        {"call": "keel_tick", "args": [{"cycle_id": "next"}, "KEEL_HEALTH_ALL"], "thread": "other"},
        {"expect": "KEEL_E_HEALTH", "state": "KEEL_STATE_FAULTED",
         "fault": {"cause": "KEEL_CAUSE_TICK_THREAD_CHANGED", "status": "KEEL_E_HEALTH", "flags": []}},
        {"call": "keel_clear_fault", "args": [], "thread": "other"},
        {"expect": "KEEL_E_CONFLICT", "state": "KEEL_STATE_FAULTED"},
        {"call": "keel_clear_fault", "args": []},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED",
         "fault": {"cause": "KEEL_CAUSE_TICK_THREAD_CHANGED", "status": "KEEL_E_HEALTH", "flags": ["KEEL_FAULT_CLEARED"]}}
      ]
    },
    {
      "name": "health_fault_recovery_and_emergency_stop",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"cycles": 5},
        {"expect": "KEEL_OK"},
        {"call": "keel_tick", "args": [{"cycle_id": "next"}, "KEEL_HEALTH_CONTROL_OK"]},
        {"expect": "KEEL_E_HEALTH", "state": "KEEL_STATE_FAULTED",
         "fault": {"cause": "KEEL_CAUSE_HEALTH_FLAGS", "status": "KEEL_E_HEALTH", "flags": []},
         "snapshot": {"fault_cause": "KEEL_CAUSE_HEALTH_FLAGS", "fault_count": 1}},
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_E_FAULTED"},
        {"cycles": 1},
        {"expect": "KEEL_E_FAULTED"},
        {"call": "keel_clear_fault", "args": []},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED",
         "fault": {"cause": "KEEL_CAUSE_HEALTH_FLAGS", "status": "KEEL_E_HEALTH", "flags": ["KEEL_FAULT_CLEARED"]}},
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_E_STATE", "snapshot": {"flags": ["KEEL_SNAP_REARM_HOLDOFF"], "last_rejection": "KEEL_E_STATE"}},
        {"cycles": 100},
        {"expect": "KEEL_OK"},
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_OK"},
        {"cycles": 100},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_emergency_stop", "args": [], "thread": "other"},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_FAULTED",
         "fault": {"cause": "KEEL_CAUSE_USER_STOP", "status": "KEEL_E_FAULTED", "flags": []}},
        {"cycles": 1},
        {"expect": "KEEL_E_FAULTED"}
      ]
    },
    {
      "name": "command_timeout_reversal_and_refused_duty",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_OK"},
        {"cycles": 100},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_set_motors", "args": [300, 300]},
        {"expect": "KEEL_OK"},
        {"cycles": 60},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED",
         "snapshot": {"flags": ["KEEL_SNAP_COMMAND_EXPIRED"], "output_left": 0, "command_left": 0}},
        {"cycles": 2, "command": "KEEL_CYCLE_DRIVE", "left": 300, "right": 300},
        {"expect": "KEEL_OK", "snapshot": {"output_left": 300}},
        {"call": "keel_set_motors", "args": [-300, -300]},
        {"expect": "KEEL_OK", "snapshot": {"flags": ["KEEL_SNAP_REVERSAL_PENDING"], "output_left": 0}},
        {"cycles": 3, "command": "KEEL_CYCLE_DRIVE", "left": -300, "right": -300},
        {"expect": "KEEL_OK", "snapshot": {"output_left": -300, "output_right": -300}},
        {"call": "keel_cycle", "args": ["KEEL_HEALTH_ALL", {"cycle_id": "next"}, "KEEL_CYCLE_DRIVE", 1001, 0, 0]},
        {"expect": "KEEL_E_INVALID_ARGUMENT", "state": "KEEL_STATE_ARMED",
         "snapshot": {"output_left": 0, "command_left": 0, "last_rejection": "KEEL_E_INVALID_ARGUMENT"}},
        {"call": "keel_set_motors", "args": [1001, 0]},
        {"expect": "KEEL_E_INVALID_ARGUMENT", "state": "KEEL_STATE_ARMED"}
      ]
    },
    {
      "name": "servo_burst",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"cycles": 250},
        {"expect": "KEEL_OK", "snapshot": {"servo_cooldown_remaining_ms": 0}},
        {"call": "keel_request_arm", "args": []},
        {"expect": "KEEL_OK"},
        {"cycles": 100},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_ARMED"},
        {"cycles": 3},
        {"expect": "KEEL_OK"},
        {"call": "keel_servo_start", "args": [1500, 300], "thread": "other"},
        {"expect": "KEEL_E_CONFLICT", "state": "KEEL_STATE_ARMED"},
        {"call": "keel_servo_start", "args": [1500, 300]},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_SERVO"},
        {"call": "keel_servo_set_pulse", "args": [1200]},
        {"expect": "KEEL_OK"},
        {"cycles": 3},
        {"expect": "KEEL_OK", "snapshot": {"servo_pulse_us": 1200, "flags": ["KEEL_SNAP_SERVO_GRANTED"]}},
        {"call": "keel_servo_end", "args": [], "thread": "other"},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED"},
        {"call": "keel_servo_end", "args": []},
        {"expect": "KEEL_OK"}
      ]
    },
    {
      "name": "capabilities_removed_by_open_flags",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR",
               "flags": ["KEEL_OPEN_VIRTUAL_CLOCK", "KEEL_OPEN_NO_SERVO", "KEEL_OPEN_NO_RANGE"]},
      "steps": [
        {"call": "keel_servo_start", "args": [1500, 100]},
        {"expect": "KEEL_E_UNSUPPORTED"},
        {"call": "keel_servo_set_pulse", "args": [1500]},
        {"expect": "KEEL_E_UNSUPPORTED"},
        {"call": "keel_range_start", "args": []},
        {"expect": "KEEL_E_UNSUPPORTED"},
        {"call": "keel_range_poll", "args": []},
        {"expect": "KEEL_E_UNSUPPORTED"}
      ]
    },
    {
      "name": "ranging",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_range_poll", "args": []},
        {"expect": "KEEL_OK", "output": {"status": "KEEL_RANGE_IDLE", "sequence": 0}},
        {"call": "keel_range_measure", "args": []},
        {"expect": "KEEL_OK", "output": {"status": "KEEL_RANGE_UNAVAILABLE"}},
        {"cycles": 30},
        {"expect": "KEEL_OK"},
        {"sim": "KEEL_SIM_RANGE_MM", "value": 750},
        {"expect": "KEEL_OK"},
        {"call": "keel_range_measure", "args": [], "thread": "other"},
        {"expect": "KEEL_OK", "output": {"status": "KEEL_RANGE_VALID", "distance_mm": 750},
         "snapshot": {"sensor_power": "KEEL_SENSOR_CONFIRMED"}},
        {"cycles": 7},
        {"expect": "KEEL_OK"},
        {"call": "keel_range_start", "args": []},
        {"expect": "KEEL_OK"},
        {"call": "keel_range_start", "args": []},
        {"expect": "KEEL_E_AGAIN"},
        {"cycles": 4},
        {"expect": "KEEL_OK"},
        {"call": "keel_range_poll", "args": []},
        {"expect": "KEEL_OK", "output": {"status": "KEEL_RANGE_VALID", "distance_mm": 750}}
      ]
    },
    {
      "name": "leds_and_buttons",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_set_rgb", "args": ["KEEL_LED_RGB1", 1056816]},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_rgb", "args": ["KEEL_LED_RGB1"]},
        {"expect": "KEEL_OK", "output": 1056816},
        {"call": "keel_set_rgb_all", "args": [255], "thread": "other"},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_rgb", "args": ["KEEL_LED_RGB6"]},
        {"expect": "KEEL_OK", "output": 255},
        {"call": "keel_set_rgb_frame", "args": [[1, 2, 3, 4, 5, 6]]},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_rgb", "args": ["KEEL_LED_RGB6"]},
        {"expect": "KEEL_OK", "output": 6},
        {"call": "keel_set_rgb_frame", "args": [[]]},
        {"expect": "KEEL_E_INVALID_ARGUMENT"},
        {"call": "keel_set_rgb", "args": [6, 0]},
        {"expect": "KEEL_E_INVALID_ARGUMENT"},
        {"sim": "KEEL_SIM_FAIL_I2C", "value": 1},
        {"expect": "KEEL_OK"},
        {"call": "keel_set_rgb_all", "args": [16711680]},
        {"expect": "KEEL_E_PERIPHERAL", "state": "KEEL_STATE_DISARMED"},
        {"call": "keel_get_rgb", "args": ["KEEL_LED_RGB1"]},
        {"expect": "KEEL_OK", "output": 1},
        {"call": "keel_set_button_leds", "args": [3, 1]},
        {"expect": "KEEL_OK", "snapshot": {"button_leds": "KEEL_BUTTON_A"}},
        {"call": "keel_set_button_leds", "args": [16, 0]},
        {"expect": "KEEL_E_INVALID_ARGUMENT"},
        {"call": "keel_sim_set", "args": ["KEEL_SIM_BUTTONS", 9]},
        {"expect": "KEEL_OK"},
        {"cycles": 4},
        {"expect": "KEEL_OK", "snapshot": {"buttons_held": 9, "buttons_pressed": 9}},
        {"call": "keel_take_buttons", "args": [], "thread": "other"},
        {"expect": "KEEL_OK", "output": {"held": 9, "pressed": 9, "released": 0}},
        {"call": "keel_take_buttons", "args": []},
        {"expect": "KEEL_OK", "output": {"held": 9, "pressed": 0}},
        {"sim": "KEEL_SIM_BUTTONS", "value": 0},
        {"expect": "KEEL_OK"},
        {"cycles": 4},
        {"expect": "KEEL_OK", "snapshot": {"buttons_held": 0, "buttons_released": 9}}
      ]
    },
    {
      "name": "injected_faults",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"sim": "KEEL_SIM_FAIL_GPIO_READS", "value": 1},
        {"expect": "KEEL_OK"},
        {"call": "keel_take_buttons", "args": []},
        {"expect": "KEEL_E_IO", "state": "KEEL_STATE_FAULTED",
         "fault": {"cause": "KEEL_CAUSE_GPIO_READ", "status": "KEEL_E_IO", "flags": []}},
        {"call": "keel_clear_fault", "args": []},
        {"expect": "KEEL_OK", "state": "KEEL_STATE_DISARMED"},
        {"sim": "KEEL_SIM_ARMED_STUCK_HIGH", "value": 1},
        {"expect": "KEEL_OK"},
        {"cycles": 5},
        {"expect": "KEEL_E_FEEDBACK", "state": "KEEL_STATE_FAULTED",
         "fault": {"cause": "KEEL_CAUSE_ARMED_UNEXPECTED", "status": "KEEL_E_FEEDBACK", "flags": ["KEEL_FAULT_STICKY"]},
         "snapshot": {"flags": ["KEEL_SNAP_FAULT_STICKY"]}},
        {"call": "keel_clear_fault", "args": []},
        {"expect": "KEEL_E_FAULTED", "state": "KEEL_STATE_FAULTED"}
      ]
    },
    {
      "name": "clock_and_fault_record",
      "open": {"backend": "KEEL_BACKEND_SIMULATOR", "flags": ["KEEL_OPEN_VIRTUAL_CLOCK"]},
      "steps": [
        {"call": "keel_now_us", "args": []},
        {"expect": "KEEL_OK"},
        {"call": "keel_sleep_until", "args": [{"now_plus_us": 20000000}]},
        {"expect": "KEEL_E_INVALID_ARGUMENT"},
        {"call": "keel_sleep_until", "args": [{"now_plus_us": 5000}]},
        {"expect": "KEEL_OK"},
        {"call": "keel_get_fault", "args": []},
        {"expect": "KEEL_OK", "output": {"status": "KEEL_OK", "cause": "KEEL_CAUSE_NONE", "fault_count": 0}}
      ]
    }
  ]
}
