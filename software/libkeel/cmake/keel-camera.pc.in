#
# The camera library libkeel-camera.so.1. Its header, keel/camera.h,
# includes keel/keel.h from the same directory; it needs no libkeel.so.
prefix=@KEEL_PC_PREFIX@
libdir=@KEEL_PC_LIBDIR@
includedir=@KEEL_PC_INCLUDEDIR@

Name: keel-camera
Description: Camera library of the Keel robot (Raspberry Pi cameras through libcamera)
Version: @KEEL_CAMERA_VERSION@
Libs: -L${libdir} -lkeel-camera
Cflags: -I${includedir}
