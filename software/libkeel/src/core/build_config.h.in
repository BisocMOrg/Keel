/**
 * @file keel_build_config.h
 * @brief Build configuration generated by CMake from src/core/build_config.h.in.
 */
#ifndef KEEL_BUILD_CONFIG_H
#define KEEL_BUILD_CONFIG_H

/** @brief Target triple named by keel_version_string(). */
#define KEEL_BUILD_TRIPLE "@KEEL_BUILD_TRIPLE@"
/** @brief Comma-separated backends compiled into the library. */
#define KEEL_BUILD_BACKENDS "@KEEL_BUILD_BACKENDS@"
/** @brief 1 when the keel_r3 backend is compiled in. */
#cmakedefine01 KEEL_HAVE_BACKEND_R3
/** @brief 1 when the simulator backend is compiled in. */
#cmakedefine01 KEEL_HAVE_BACKEND_SIM

#endif /* KEEL_BUILD_CONFIG_H */
