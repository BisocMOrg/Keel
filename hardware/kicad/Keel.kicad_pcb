	(footprint "Keel:DRV8411A_PWP0016_C01_ExternalVias"
		(layer "F.Cu")
		(uuid "167669a6-55d7-48f4-b875-1b82fd34d170")
		(at 103 112.6 -90)
		(descr "PWP0016-C01 actual solder land; external ordinary thermal vias and separate masked ground heat-spreader. No via in U1 solder land. TI SLOA120 pp3-4; long-term thermal behaviour not yet characterised.")
		(tags "datasheet verified")
