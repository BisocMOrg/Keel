	)
	(text "Notes"
		(exclude_from_sim no)
		(at 170.18 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b069a141-82fd-5375-a61f-4741e65b7250")
	)
	(text "1. U3 has the fixed 7-bit I2C address 0x54. U3_SDA and U3_SCL come from\n   repeater U7 on sheet 7 (Protected external signals); R38/R39 (1.8 kΩ)\n   pull them up to SYS_5V.\n2. SDB is tied to SYS_5V: U3 is switched on and off through register 0x00.\n3. R7 (12 kΩ) sets the output current to 6.3 mA peak per channel; each\n   channel has an 8-bit PWM register for its brightness.\n4. RGB1-RGB6 are mounted on the bottom side, with their anodes on SYS_5V."
		(exclude_from_sim no)
		(at 171.45 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2b729fa5-870e-5f97-a77e-24e798216179")
	)
