	(text "SENSOR_5V: switch U30 (108-154 mA limit).\nTRIG_EXT from buffer U8 via R5; ECHO_INPUT to buffer U9.\nU30, U8 and U9 are on sheet 7 (Protected external signals).\nClamp U24 on pins 1-3: sheet 9 (Connector-local ESD)."
		(exclude_from_sim no)
		(at 193.04 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e3ea5d33-c7e3-5597-bd1e-b6ff07e5210c")
	)
	(text "SERVO_5V: switch U15 (444-568 mA limit) on\nsheet 4 (Independent safety supervisor).\nSERVO_EXT from buffer U8 via R6 on sheet 7\n(Protected external signals).\nClamp U26 on pins 2 and 3: sheet 9 (Connector-local ESD)."
		(exclude_from_sim no)
		(at 193.04 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4cee8454-0709-5eec-896c-837f895fccd9")
	)
	(text "Notes"
		(exclude_from_sim no)
		(at 20.32 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2d4c855f-59cc-53bb-bbd7-1c013829e5e1")
	)
	(text "1. The buttons are active low with no external pull-ups: the host enables its internal GPIO pull-ups.\n2. Each button and indicator line runs through a 1 kΩ element of RN1 or RN2. It limits the current into a\n   host pin driven against a pressed button, and sets the indicator current below 1 mA from 3.3 V.\n3. D8-D11 on sheet 9 (Connector-local ESD) clamp SW_A_EXT, SW_B_EXT, SW_X_EXT and SW_Y_EXT."
		(exclude_from_sim no)
		(at 21.59 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ffd66d1b-84cf-56cf-97c8-77972df8113f")
	)
