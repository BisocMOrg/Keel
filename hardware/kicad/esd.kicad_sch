	(text "Notes"
		(exclude_from_sim no)
		(at 16.51 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9a3ee98e-e129-5903-8d9f-506bf1da59b0")
	)
	(text "1. Each clamp sits beside the connector or switch it protects, with a short, direct return to GND.\n2. IO1 of each array clamps the connector supply pin (EXP_3V3, SENSOR_5V or SERVO_5V).\n3. The clamps absorb ESD transients only. Sustained faults are handled downstream by the series resistors,\n   current-limited supplies and the over-voltage protector on sheet 2 (Protected power domains),\n   sheet 4 (Independent safety supervisor), sheet 7 (Protected external signals) and sheet 8 (Buttons and indicators).\n4. TPD4E05U06 pins 6, 7, 9 and 10 are NC flow-through pads; spare IO channels are left open."
		(exclude_from_sim no)
		(at 17.78 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dd395e2f-77c5-5489-877e-39758d98a69b")
	)
